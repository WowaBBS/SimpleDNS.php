<?
include_once '../_Cli.php' ;
include_once '_All.php';

/* ============================================================
 * Один и тот же запрос через разные транспорты
 * ============================================================ */

$transports = [
  new DohTransport()                  , // DoH (RFC 8484), HTTPS 443
  new UdpTransport ('1.1.1.1')        , // UDP, 53
  new TcpTransport ('1.1.1.1')        , // TCP, 53
  new DotTransport ('one.one.one.one'), // DoT, 853
];

foreach ($transports as $transport)
{
  echo "--- ", $transport->name(), " ---\n";

  try
  {
    $reply = $transport->exchange(DnsMessage::query('example.com', 1));

    echo 'rcode: ', DnsHeader::rcodeName($reply->rcode()), "\n";
    foreach ($reply->answers as $record)
      echo '  ', $record, "\n";
  }
  catch (Throwable $e)
  {
    echo '  ошибка: ', $e->getMessage(), "\n";
  }

  echo "\n";
}

// Выбор транспорта по адресу
$dns = TransportFactory::fromUrl('udp://1.1.1.1');
echo $dns->name(), "\n";