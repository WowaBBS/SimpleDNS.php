<?php
declare(strict_types=1);

include_once '../_Cli.php' ;
include_once '_All.php';
include_once '../Debug/Test.php';

$t = new TestRunner();

/* ---------- Двоичный слой ---------- */
DnsReader     ::test($t); // чтение: границы, имена, указатели
DnsWriter     ::test($t); // запись: числа, диапазоны, имена, tell
NameCodec     ::test($t); // имена без сжатия

/* ---------- Сообщение ---------- */
DnsHeader     ::test($t); // заголовок: точные байты и разбор
DnsMessage    ::test($t); // круговое преобразование и золотые векторы
DnsMessage    ::testWrite($t);    // serialize()/serializeWith()/writeTo()
DnsMessage    ::testCompress($t); // сжатие: суффиксы, RDATA, граница 0x4000

/* ---------- RDATA ---------- */
DnsRdata      ::test($t); // типы записей и границы RDATA
NamedRdata    ::test($t); // имена внутри RDATA с указателями
OptRecord     ::test($t); // OPT / EDNS
RdataRegistry ::test($t); // реестр типов

/* ---------- JSON-слой ---------- */
JsonReader    ::test($t); // чтение: типы, пути, значения по умолчанию
JsonWriter    ::test($t); // запись: запятые, пустые контейнеры, поток
StrCodec      ::test($t); // экранирование презентационных строк

/* ---------- JSON (RFC 8427) ---------- */
NameCodec     ::testJson($t); // имена в презентационном виде
DnsRdata      ::testJson($t); // Data: текстовый вид RDATA
TxtRecord     ::testJson($t); // экранирование строк
CaaRecord     ::testJson($t); // tag/value
UnknownRdata  ::testJson($t); // механизм \#
DnsRecord     ::testJson($t); // запись целиком
DnsMessage    ::testJson($t); // сообщение целиком, вектор Google

$t->summary();